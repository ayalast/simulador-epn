# Copia local — NO subir el token al repo.
# GitHub Actions necesita estos secrets en el repo:
#   CLOUDFLARE_API_TOKEN   (Edit Cloudflare Workers / Pages)
#   CLOUDFLARE_ACCOUNT_ID  = 44af12f62893c26eb15fab9bc9ddd90c
#
# Crear token: https://dash.cloudflare.com/profile/api-tokens
# Plantilla recomendada: "Edit Cloudflare Workers"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=44af12f62893c26eb15fab9bc9ddd90c
